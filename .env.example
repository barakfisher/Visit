NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=3000
DATABASE_URL=postgresql://visit:visit_local_only@localhost:5432/visit?schema=public
REDIS_URL=redis://localhost:6380
EXPO_PUBLIC_API_URL=http://localhost:3000
SESSION_SECRET=replace-with-a-random-local-development-secret-at-least-32-characters
EMAIL_DELIVERY_MODE=local-inbox
EMAIL_FROM=Visit <login@localhost>
WEB_APP_URL=http://localhost:8081
PLATFORM_ADMIN_EMAILS=

# Optional phone/Google authentication. Default buttons remain disabled without configuration.
SMS_DELIVERY_MODE=disabled
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
GOOGLE_CLIENT_IDS=

# Leave empty for direct access. Staging must supply only actual reverse proxy IP/CIDRs.
TRUSTED_PROXY_CIDRS=
