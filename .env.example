NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=3000
DATABASE_URL=postgresql://visit:visit_local_only@localhost:5432/visit?schema=public
REDIS_URL=redis://localhost:6380
EXPO_PUBLIC_API_URL=http://localhost:3000
SESSION_SECRET=replace-with-a-random-local-development-secret-at-least-32-characters
EMAIL_DELIVERY_MODE=local-inbox
EMAIL_FROM=Visit <login@localhost>
WEB_APP_URL=http://localhost:8081
# Legacy bootstrap hint, ignored by public authentication; admin promotion requires an explicit operator workflow.
PLATFORM_ADMIN_EMAILS=

# Optional phone/Google authentication. Default buttons remain disabled without configuration.
SMS_DELIVERY_MODE=disabled
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Optional separate Twilio Messaging service for account security alerts (Verify cannot send these).
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_VERIFY_SERVICE_SID=
# Google authorization-code broker (legacy GOOGLE_CLIENT_IDS is no longer used)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=
# Development only: visit://auth/google; production requires a claimed HTTPS app link.
GOOGLE_NATIVE_RETURN_URL=

# Leave empty for direct access. Staging must supply only actual reverse proxy IP/CIDRs.
TRUSTED_PROXY_CIDRS=
