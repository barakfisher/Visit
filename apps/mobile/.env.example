EXPO_PUBLIC_API_URL=http://localhost:3000
# Optional: the browser's API address when EXPO_PUBLIC_API_URL is set for a phone (a LAN or Tailscale host).
# The page on localhost must call localhost, or sign-in succeeds and the session cookie never comes back.
# EXPO_PUBLIC_WEB_API_URL=http://localhost:3000
# Optional claimed app/universal return. Must exactly match the server GOOGLE_NATIVE_RETURN_URL.
# A new native build and hosted Apple/Android association files are required (VIS-43).
# Leave empty locally; development builds may use visit://auth/google when the API allows it.
EXPO_PUBLIC_GOOGLE_NATIVE_RETURN_URL=
