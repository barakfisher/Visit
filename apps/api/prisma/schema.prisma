generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PlatformRole {
  USER
  ADMIN
}

enum MembershipRole {
  OWNER
  MANAGER
  STAFF
}

enum MembershipStatus {
  PENDING
  ACTIVE
  REVOKED
}

enum BusinessApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum BookingStatus {
  HELD
  CONFIRMED
  COMPLETED
  CANCELLED
  EXPIRED
}

enum ChallengePurpose {
  EMAIL_LOGIN
  EMAIL_VERIFY
}

model Identity {
  displayName String?
  accessEventsActed BusinessAccessEvent[] @relation("AccessActor")
  accessEventsSubject BusinessAccessEvent[] @relation("AccessSubject")
  invitationsRevoked BusinessInvitation[] @relation("InvitationRevoker")
  createdBusinessInvitations BusinessInvitation[] @relation("InvitationCreator")
  acceptedBusinessInvitations BusinessInvitation[] @relation("InvitationRecipient")
  ownershipClaims BusinessOwnershipReview[] @relation("OwnershipClaimant")
  ownershipCasesCreated BusinessOwnershipReview[] @relation("OwnershipCaseCreator")
  ownershipCasesReviewed BusinessOwnershipReview[] @relation("OwnershipCaseReviewer")
  savedProviders SavedProvider[]
  securityVersion Int @default(0)
  contactChallenges AccountContactChallenge[]
  securityEvents IdentitySecurityEvent[]
  securityNotifications SecurityNotification[]
  phoneVerifiedAt DateTime?
  id                    String             @id @default(cuid())
  email                 String?            @unique
  emailVerifiedAt       DateTime?
  phone                 String?            @unique
  preferredLocale       String?
  platformRole          PlatformRole       @default(USER)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  memberships           Membership[]
  sessions              Session[]
  googleAuthProofs      GoogleAuthProof[]
  externalIdentities    ExternalIdentity[]
  emailChallenges       EmailChallenge[]
  providerApplications  ProviderApplication[]
  customerBookings      Booking[]           @relation("CustomerBookings")
  reviewedBusinesses   Business[]          @relation("BusinessReviewer")
  reviewedApplications ProviderApplication[] @relation("ProviderApplicationReviewer")
}

model Business {
  accessEvents BusinessAccessEvent[]
  invitations BusinessInvitation[]
  ownershipReviews BusinessOwnershipReview[]
  deletedAt DateTime?
  savedBy SavedProvider[]
  publishedAt DateTime?
  id                 String                 @id @default(cuid())
  name               String
  slug               String                 @unique
  timezone           String
  location           String?
  description        String?
  contactEmail       String?
  contactPhone       String?
  category           String                 @default("General")
  approvalStatus     BusinessApprovalStatus @default(PENDING)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  reviewedAt         DateTime?
  reviewedById       String?
  reviewedBy         Identity?              @relation("BusinessReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  memberships        Membership[]
  staff              Staff[]
  services           Service[]
  weeklyAvailability BusinessWeeklyAvailability[]
  scheduleOverrides  ScheduleOverride[]
  bookingPolicy      BookingPolicy?
  bookings           Booking[]
  providerApplications ProviderApplication[]
  timeBlocks         TimeBlock[]
}

model Membership {
  accessEvents BusinessAccessEvent[]
  createdInvitations BusinessInvitation[]
  id         String           @id @default(cuid())
  identityId String
  businessId String
  role       MembershipRole
  status     MembershipStatus @default(PENDING)
  createdAt  DateTime         @default(now())
  identity   Identity         @relation(fields: [identityId], references: [id], onDelete: Cascade)
  business   Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([identityId, businessId, role])
  @@unique([businessId, id, identityId])
  @@index([businessId, status, role])
}

model ProviderApplication {
  kind String @default("LEGACY")
  reviewReason String?
  notification ProviderReviewNotification?
  id            String                 @id @default(cuid())
  identityId    String
  businessId    String
  status        BusinessApprovalStatus @default(PENDING)
  message       String?
  createdAt     DateTime               @default(now())
  reviewedAt    DateTime?
  reviewedById  String?
  identity      Identity               @relation(fields: [identityId], references: [id], onDelete: Cascade)
  business      Business               @relation(fields: [businessId], references: [id], onDelete: Cascade)
  reviewedBy    Identity?              @relation("ProviderApplicationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@unique([identityId, businessId])
}

model ExternalIdentity {
  id           String   @id @default(cuid())
  identityId   String
  provider     String
  subject      String
  email        String?
  createdAt    DateTime @default(now())
  identity     Identity @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@unique([provider, subject])
}

model EmailChallenge {
  deliveredAt  DateTime?
  id           String          @id @default(cuid())
  identityId   String?
  email        String
  tokenHash    String          @unique
  purpose      ChallengePurpose @default(EMAIL_LOGIN)
  expiresAt    DateTime
  consumedAt   DateTime?
  attempts     Int             @default(0)
  createdAt    DateTime        @default(now())
  identity     Identity?       @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@index([email, createdAt])
  @@index([expiresAt, consumedAt])
}

model Session {
  contactChallenges AccountContactChallenge[]
  authenticationProofHash String? @unique
  refreshExpiresAt DateTime  @default(dbgenerated("(CURRENT_TIMESTAMP + '30 days'::interval)"))
  familyId         String    @default(dbgenerated("(gen_random_uuid())::text"))
  authenticatedAt  DateTime  @default(now())
  id               String    @id @default(cuid())
  identityId       String
  tokenHash        String    @unique
  createdAt        DateTime  @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?
  replacedById     String?
  identity         Identity  @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@index([identityId, expiresAt])
  @@index([familyId])
  @@unique([id, identityId])
}

model Staff {
  creationKey String?
  creationFingerprint String?
  id             String                 @id @default(cuid())
  businessId     String
  displayName    String
  active         Boolean                @default(true)
  parallelCapacity Int                  @default(1)
  createdAt      DateTime               @default(now())
  business       Business               @relation(fields: [businessId], references: [id], onDelete: Cascade)
  services       StaffService[]
  availability   StaffWeeklyAvailability[]
  overrides      StaffScheduleOverride[]
  bookings       Booking[]
  timeBlocks     TimeBlock[]

  @@unique([businessId, id])
  @@unique([businessId, creationKey])
  @@index([businessId, active])
}

model Service {
  id              String          @id @default(cuid())
  businessId      String
  name            String
  description     String?
  durationMinutes Int
  priceMinor      Int?
  currency        String?
  active          Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  business        Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  staff           StaffService[]
  bookings        Booking[]

  @@unique([businessId, id])
  @@index([businessId, active])
}

model StaffService {
  businessId String
  staffId    String
  serviceId  String
  staff      Staff   @relation(fields: [businessId, staffId], references: [businessId, id], onDelete: Cascade)
  service    Service @relation(fields: [businessId, serviceId], references: [businessId, id], onDelete: Cascade)

  @@id([businessId, staffId, serviceId])
  @@index([businessId, serviceId])
}

model BusinessWeeklyAvailability {
  id          String   @id @default(cuid())
  businessId  String
  weekday     Int
  startLocal  String
  endLocal    String
  createdAt   DateTime @default(now())
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, weekday])
}

model StaffWeeklyAvailability {
  id          String   @id @default(cuid())
  businessId  String
  staffId     String
  weekday     Int
  startLocal  String
  endLocal    String
  createdAt   DateTime @default(now())
  staff       Staff    @relation(fields: [businessId, staffId], references: [businessId, id], onDelete: Cascade)

  @@index([businessId, staffId, weekday])
}

model ScheduleOverride {
  id          String   @id @default(cuid())
  businessId  String
  date        DateTime @db.Date
  isOpen      Boolean
  startLocal  String?
  endLocal    String?
  createdAt   DateTime @default(now())
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, date])
}

model StaffScheduleOverride {
  id          String   @id @default(cuid())
  businessId  String
  staffId     String
  date        DateTime @db.Date
  isOpen      Boolean
  startLocal  String?
  endLocal    String?
  createdAt   DateTime @default(now())
  staff       Staff    @relation(fields: [businessId, staffId], references: [businessId, id], onDelete: Cascade)

  @@index([businessId, staffId, date])
}

model BookingPolicy {
  requireCustomerName Boolean @default(false)
  requireVerifiedPhone Boolean @default(false)
  requireVerifiedEmail Boolean @default(false)
  id                       String   @id @default(cuid())
  businessId               String   @unique
  minimumNoticeMinutes     Int
  maximumAdvanceDays       Int
  bufferBeforeMinutes      Int      @default(0)
  bufferAfterMinutes       Int      @default(0)
  cancellationCutoffMinutes Int
  rescheduleCutoffMinutes  Int
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
  business                 Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model Booking {
  customerName String?
  customerPhone String?
  customerEmail String?
  customerPhoneVerifiedAt DateTime? @db.Timestamptz(3)
  customerEmailVerifiedAt DateTime? @db.Timestamptz(3)
  customerContactCapturedAt DateTime? @db.Timestamptz(3)
  id              String        @id @default(cuid())
  businessId      String
  customerId      String
  staffId         String
  serviceId       String
  startsAt        DateTime
  endsAt          DateTime
  occupiedFrom    DateTime
  occupiedUntil   DateTime
  status          BookingStatus @default(HELD)
  serviceName     String        @default("")
  serviceDurationMinutes Int    @default(0)
  servicePriceMinor Int?
  serviceCurrency String?
  idempotencyKey  String
  holdExpiresAt   DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  business        Business      @relation(fields: [businessId], references: [id], onDelete: Restrict)
  customer        Identity      @relation("CustomerBookings", fields: [customerId], references: [id], onDelete: Restrict)
  staff           Staff         @relation(fields: [businessId, staffId], references: [businessId, id], onDelete: Restrict)
  service         Service       @relation(fields: [businessId, serviceId], references: [businessId, id], onDelete: Restrict)

  @@unique([businessId, id])
  @@unique([businessId, idempotencyKey])
  @@index([businessId, staffId, occupiedFrom, occupiedUntil, status])
  @@index([customerId, startsAt])
}

model TimeBlock {
  id         String   @id @default(cuid())
  businessId String
  staffId    String
  startsAt   DateTime
  endsAt     DateTime
  reason     String?
  createdAt  DateTime @default(now())
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  staff      Staff    @relation(fields: [businessId, staffId], references: [businessId, id], onDelete: Cascade)

  @@index([businessId, staffId, startsAt, endsAt])
}

model GoogleAuthProof {
  hash String @id
  identityId String
  intent String
  createdAt DateTime @default(now())
  identity Identity @relation(fields: [identityId], references: [id], onDelete: Cascade)
  @@index([identityId])
}


model AccountContactChallenge {
  id String @id @default(cuid())
  handleHash String @unique
  identityId String
  sessionId String
  securityVersion Int
  channel String
  destination String
  codeHash String?
  attempts Int @default(0)
  expiresAt DateTime @db.Timestamptz
  deliveredAt DateTime? @db.Timestamptz
  consumedAt DateTime? @db.Timestamptz
  createdAt DateTime @default(now()) @db.Timestamptz
  identity Identity @relation(fields: [identityId], references: [id], onDelete: Cascade)
  session Session @relation(fields: [sessionId, identityId], references: [id, identityId], onDelete: Cascade)
  @@index([identityId, consumedAt])
  @@index([expiresAt])
}

model IdentitySecurityEvent {
  id String @id @default(cuid())
  identityId String
  action String
  method String
  createdAt DateTime @default(now()) @db.Timestamptz
  identity Identity @relation(fields: [identityId], references: [id], onDelete: Cascade)
  notifications SecurityNotification[]
  @@unique([id, identityId])
  @@index([identityId, createdAt])
}

model SecurityNotification {
  scope String @default("live")
  id String @id @default(cuid())
  identityId String
  eventId String
  channel String
  destination String?
  status String @default("QUEUED")
  attempts Int @default(0)
  nextAttemptAt DateTime @default(now()) @db.Timestamptz
  leaseUntil DateTime? @db.Timestamptz
  acceptedAt DateTime? @db.Timestamptz
  provider String?
  createdAt DateTime @default(now()) @db.Timestamptz
  identity Identity @relation(fields: [identityId], references: [id], onDelete: Cascade)
  event IdentitySecurityEvent @relation(fields: [eventId, identityId], references: [id, identityId], onDelete: Cascade)
  @@index([scope, status, nextAttemptAt])
  @@index([identityId, createdAt])
}

model ProviderReviewNotification {
  id String @id @default(cuid())
  applicationId String @unique
  application ProviderApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  scope String @default("live")
  destination String?
  locale String?
  status String @default("QUEUED")
  attempts Int @default(0)
  nextAttemptAt DateTime @default(now()) @db.Timestamptz
  leaseUntil DateTime? @db.Timestamptz
  acceptedAt DateTime? @db.Timestamptz
  provider String?
  createdAt DateTime @default(now()) @db.Timestamptz
  @@index([scope, status, nextAttemptAt])
}
model AdminRoleAudit {
  id String @id @default(cuid())
  identityId String
  operator String
  reason String
  previousRole String
  createdAt DateTime @default(now()) @db.Timestamptz
}

model SavedProvider {
  id String @id @default(cuid())
  identityId String
  businessId String
  displayName String
  savedAt DateTime @default(now()) @db.Timestamptz
  identity Identity @relation(fields: [identityId], references: [id], onDelete: Cascade)
  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  @@unique([identityId, businessId])
  @@index([identityId, savedAt, id])
}

model BusinessInvitation {
  revokedByIdentityId String?
  revokedBy Identity? @relation("InvitationRevoker", fields: [revokedByIdentityId], references: [id], onDelete: Restrict)
  id String @id @default(cuid())
  businessId String
  inviterIdentityId String
  inviterMembershipId String
  inviterRole MembershipRole
  role MembershipRole
  recipientChannel String
  recipientDigest String
  recipientHint String
  tokenHash String @unique
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  expiresAt DateTime @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)
  acceptedAt DateTime? @db.Timestamptz(3)
  acceptedByIdentityId String?
  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  inviter Identity @relation("InvitationCreator", fields: [inviterIdentityId], references: [id], onDelete: Restrict)
  inviterMembership Membership @relation(fields: [businessId, inviterMembershipId, inviterIdentityId], references: [businessId, id, identityId], onDelete: Restrict, onUpdate: Restrict)
  acceptedBy Identity? @relation("InvitationRecipient", fields: [acceptedByIdentityId], references: [id], onDelete: Restrict)
  @@index([businessId, createdAt])
}

model BusinessOwnershipReview {
  id String @id @default(cuid())
  businessId String
  claimantIdentityId String
  claimantSecurityVersion Int
  createdByIdentityId String
  reviewedByIdentityId String?
  caseReference String @unique
  evidenceKind String
  evidenceSummary String
  status String @default("PENDING")
  reason String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  reviewedAt DateTime? @db.Timestamptz(3)
  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  claimant Identity @relation("OwnershipClaimant", fields: [claimantIdentityId], references: [id], onDelete: Restrict)
  createdBy Identity @relation("OwnershipCaseCreator", fields: [createdByIdentityId], references: [id], onDelete: Restrict)
  reviewedBy Identity? @relation("OwnershipCaseReviewer", fields: [reviewedByIdentityId], references: [id], onDelete: Restrict)
  @@index([status, createdAt])
}

model BusinessAccessEvent {
  id String @id @default(cuid())
  businessId String
  membershipId String
  subjectIdentityId String
  actorIdentityId String
  role MembershipRole
  action String
  referenceId String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  membership Membership @relation(fields: [businessId, membershipId, subjectIdentityId], references: [businessId, id, identityId], onDelete: Restrict, onUpdate: Restrict)
  subject Identity @relation("AccessSubject", fields: [subjectIdentityId], references: [id], onDelete: Restrict)
  actor Identity @relation("AccessActor", fields: [actorIdentityId], references: [id], onDelete: Restrict)
  @@index([businessId, createdAt])
}
